{
  "expo": {
    "name": "SimpleSwing",
    "slug": "simple-swing",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "simpleswing",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "bundleIdentifier": "app.simpleswing",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "SimpleSwing records your golf swing so you can replay it in slow motion.",
        "NSMicrophoneUsageDescription": "SimpleSwing listens for the sound of club hitting ball to capture your swing automatically. Audio never leaves your device.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocalNetworkUsageDescription": "SimpleSwing connects to your other phone on the same Wi-Fi so it can film a second angle of your swing. Nothing leaves your local network.",
        "NSBonjourServices": [
          "_simpleswing._tcp"
        ]
      },
      "buildNumber": "1",
      "requireFullScreen": true
    },
    "android": {
      "package": "app.simpleswing",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.CHANGE_WIFI_MULTICAST_STATE"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_SETTINGS",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#146B3A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 1
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#146B3A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-video",
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": false,
          "savePhotosPermission": "SimpleSwing saves the swing clips you choose to your Photos library.",
          "granularPermissions": [
            "video"
          ]
        }
      ],
      "./plugins/with-release-signing",
      "./plugins/with-android-policy"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
