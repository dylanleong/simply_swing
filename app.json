{
  "expo": {
    "name": "SimpleSwing",
    "slug": "simple-swing",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "simpleswing",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "bundleIdentifier": "app.simpleswing",
      "supportsTablet": true,
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "NSCameraUsageDescription": "SimpleSwing records your golf swing so you can replay it in slow motion.",
        "NSMicrophoneUsageDescription": "SimpleSwing listens for the sound of club hitting ball to capture your swing automatically. Audio never leaves your device.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.simpleswing",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_SETTINGS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#146B3A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#146B3A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-video",
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": false,
          "savePhotosPermission": "SimpleSwing saves the swing clips you choose to your Photos library.",
          "granularPermissions": [
            "video"
          ]
        }
      ],
      "./plugins/with-release-signing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
